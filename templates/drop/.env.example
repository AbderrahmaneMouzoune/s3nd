# The bucket the transfers land in, and a key pair scoped to it. Any
# S3-compatible provider works: R2, S3, MinIO, Scaleway, Wasabi.
#
# Cloudflare R2 (no egress fees):
S3ND_BUCKET=drop
S3ND_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3ND_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 proper: leave S3ND_ENDPOINT empty and set a real region.
# S3ND_REGION=eu-west-3

# A MinIO on your laptop, for development:
#   docker run -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#     quay.io/minio/minio server /data --console-address ":9001"
# S3ND_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Optional: the folder inside the bucket. Give it a lifecycle rule.
# S3ND_PREFIX=drop

# Optional: ask for a password before an upload. Picking up never asks.
# Without it, anyone who finds the page can drop a file in your bucket.
# DROP_PASSWORD=

# Optional: how long a transfer lives when the sender chooses nothing, in
# seconds. One day by default.
# DROP_EXPIRES_IN=86400

# Optional: the longest life a sender may choose on the form, in seconds.
# Seven days by default. A default longer than this comes down to it.
# DROP_MAX_EXPIRES_IN=604800

# Optional: the largest file accepted, in megabytes. 4 by default, which
# sits under the 4.5 MB request limit of Vercel functions.
# DROP_MAX_SIZE_MB=4

# Optional: how a download is served. "stream" pipes the bytes through the
# function (the default, works everywhere); "redirect" answers 302 with a
# presigned URL so they come straight from the bucket.
# DROP_RAW_MODE=stream

# Optional: show what is behind a code — the image, the video, the first
# lines of the text — on the pickup page, before anything is downloaded.
# DROP_PREVIEW=true

# Optional: the largest file a preview will render, in megabytes. 16 by
# default. A preview pulls the object through the function like a download
# does; above this, the page describes the file instead of showing it.
# DROP_PREVIEW_MAX_MB=16

# Optional: the name shown in the header.
# DROP_NAME=drop

# Optional: the public URL, for absolute links. On Vercel the production
# domain is used when this is unset.
# DROP_URL=https://drop.s3nd.sh

{
  "name": "s3nd-drop",
  "version": "0.1.0",
  "private": true,
  "description": "A small WeTransfer on your own S3 bucket: drop a file, get a code and a link, pick it up anywhere until it expires. Built on s3nd, deployed to Vercel in one click.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3400",
    "build": "next build",
    "start": "next start --port 3400",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@s3nd/core": "^0.1.0",
    "@s3nd/react": "^0.1.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
